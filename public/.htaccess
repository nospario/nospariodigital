# ===========================================================================
# Nospario Digital — Apache configuration (document root = /public)
# ===========================================================================

Options -Indexes
DirectoryIndex index.php

# --- Force HTTPS + canonical host -----------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS (respect proxy header on shared hosting where applicable).
  # Skip for localhost/127.0.0.1 so local + Docker testing over http works.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Pretty URLs: /privacy -> /privacy.php (no extension)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^([^.]+)$ $1.php [L]

  # Strip a trailing .php from the visible URL (301 to the clean form).
  # Never redirect POSTs — that would drop the form body (e.g. contact.php).
  RewriteCond %{REQUEST_METHOD} !=POST
  RewriteCond %{THE_REQUEST} \s/+([^.\s]+)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
</IfModule>

# --- Security headers ------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Starter CSP — allows Google Fonts and the Heart Internet status feed.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; connect-src 'self' https://www.heartstatus.uk; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
  # HSTS (enable once HTTPS is confirmed everywhere)
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# --- Compression -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css \
    application/javascript application/json image/svg+xml application/manifest+json
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript \
    application/json image/svg+xml application/manifest+json
</IfModule>

# --- Caching ---------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|jpg|jpeg|png|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# --- Protect dotfiles + env ------------------------------------------------
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<Files ".env">
  Require all denied
</Files>
