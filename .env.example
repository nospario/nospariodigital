# Copy to .env and fill in. NEVER commit the real .env.
# The app loads these automatically (see src/config.php).

# Canonical site URL (used in all metadata + redirects)
SITE_URL=https://www.nospariodigital.co.uk

# Where contact + ticket submissions are delivered
MAIL_TO=theteam@nospariodigital.co.uk

# From address for outgoing mail (use a domain mailbox)
MAIL_FROM=no-reply@nospariodigital.co.uk

# SMTP (recommended — used when PHPMailer is installed via Composer).
# Leave SMTP_HOST blank to fall back to PHP's mail().
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# tls (STARTTLS, port 587) or ssl (SMTPS, port 465)
SMTP_SECURE=tls
